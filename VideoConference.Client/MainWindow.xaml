<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VideoConference.Client"        
        Title="Video Conference Client" 
        WindowState="Maximized"  
        WindowStyle="SingleBorderWindow"
        Height="1080" Width="1920">

    <Grid x:Name="MainContentGrid" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Connection + Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Status -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <!-- Left panel (video locale + remoto) -->
            <ColumnDefinition Width="5*"/>
            <!-- Screen share -->
            <ColumnDefinition Width="3*"/>
            <!-- Right panel (chat) -->
        </Grid.ColumnDefinitions>

        <!-- Connection + Controls Panel (tutti sulla stessa riga) -->
        <GroupBox Header="Connessione e Controlli" Grid.Row="0" Grid.ColumnSpan="3" Margin="5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <!-- Connessione -->
                    <TextBox x:Name="txtServerUrl" Text="https://192.168.1.56:5001" Width="180" Margin="2"/>
                    <TextBox x:Name="txtUserName" Text="Utente1" Width="80" Margin="2"/>
                    <TextBox x:Name="txtRoomId" Text="stanza1" Width="80" Margin="2"/>
                    <Button x:Name="btnConnect" Content="Connetti" Width="70" Margin="2" Height="30"/>
                    <Button x:Name="btnDisconnect" Content="Disconnetti" Width="80" Margin="2" Height="30"/>

                    <!-- Separatore visivo -->
                    <Rectangle Width="1" Fill="Gray" Margin="5,0" Height="30"/>

                    <!-- Controlli Video -->
                    <Button x:Name="btnStartVideo" Content="Avvia Video" Width="90" Margin="2" Height="30"/>
                    <Button x:Name="btnStopVideo" Content="Ferma Video" Width="90" Margin="2" Height="30"/>

                    <!-- Controlli Audio -->
                    <Button x:Name="btnStartAudio" Content="Avvia Audio" Width="90" Margin="2" Height="30"/>
                    <Button x:Name="btnStopAudio" Content="Ferma Audio" Width="90" Margin="2" Height="30"/>

                    <!-- Screen Share -->
                    <Button x:Name="btnShareScreen" Content="🖥️ Condividi" Width="100" Margin="2" Height="30" Background="LightBlue" FontWeight="Bold"/>
                    <Button x:Name="btnStopShare" Content="⏹️ Ferma" Width="80" Margin="2" Height="30" Background="LightPink" FontWeight="Bold" IsEnabled="False"/>

                    <!-- Pulsante Chat Collapse -->
                    <Button x:Name="btnToggleChat" Content="💬 Chat" Width="80" Margin="2" Height="30" Background="LightGray" FontWeight="Bold" Click="btnToggleChat_Click"/>

                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- Status Panel -->
        <GroupBox Header="Stato" Grid.Row="1" Grid.ColumnSpan="3" Margin="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtStatus" Text="Non connesso" Margin="5" VerticalAlignment="Center" FontWeight="Bold" MinWidth="150"/>
                <TextBlock x:Name="txtVideoStatus" Text="Video: Disattivo" Margin="10" VerticalAlignment="Center" Foreground="Red" FontWeight="Bold" MinWidth="100"/>
                <TextBlock x:Name="txtAudioStatus" Text="Audio: Disattivo" Margin="10" VerticalAlignment="Center" Foreground="Red" FontWeight="Bold" MinWidth="100"/>
            </StackPanel>
        </GroupBox>

        <!-- PANNELLO SINISTRO (Colonna 0) - Video locale sopra, video remoto sotto -->
        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <!-- Video Locale -->
                <RowDefinition Height="140"/>
                <!-- Video Remoto (tutto il resto) -->
                <RowDefinition Height="*"/>
                <!-- elenco utenti -->
            </Grid.RowDefinitions>

            <!-- Video Locale -->
            <GroupBox Header="Il mio video" Grid.Row="0" Margin="0,0,0,5">
                <Border BorderBrush="Gray" BorderThickness="1" Background="Black">
                    <Grid>
                        <Image x:Name="localVideoImage" Stretch="Uniform" MaxHeight="120"/>
                        <TextBlock x:Name="txtLocalVideoPlaceholder" 
                                  Text="Webcam non attiva" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="White" FontSize="12"
                                  TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                </Border>
            </GroupBox>

            <!-- Video Remoto (occupa tutto lo spazio rimanente) -->
            <GroupBox Header="Video remoto" Grid.Row="1" Margin="0,5,0,0">
                <Border BorderBrush="Gray" BorderThickness="1" Background="Black">
                    <Grid>
                        <Image x:Name="remoteVideoImage" Stretch="Uniform"/>
                        <TextBlock x:Name="txtRemoteVideoPlaceholder" 
                                   Text="In attesa di connessione remota" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" FontSize="14"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                </Border>
            </GroupBox>

            <!-- Lista partecipanti -->
            <GroupBox Header="Partecipanti" Grid.Row="2" Margin="0,0,0,5">
                <ListBox x:Name="lstParticipants" 
                             Background="#2D2D30" 
                             Foreground="White" 
                             BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="🎥" Margin="0,0,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVideo}" Value="True">
                                                    <Setter Property="Foreground" Value="LightGreen"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="🎤" Margin="0,0,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAudio}" Value="True">
                                                    <Setter Property="Foreground" Value="LightGreen"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="🖥️" Margin="0,0,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScreenSharing}" Value="True">
                                                    <Setter Property="Foreground" Value="LightGreen"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding UserName}" Margin="2,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

        </Grid>

        <!-- COLONNA CENTRALE: Screen Share (Colonna 1) -->
        <GroupBox Header="Condivisione Schermo" Grid.Row="2" Grid.Column="1" Margin="5">
            <Border BorderBrush="Gray" BorderThickness="1" Background="Black">
                <Grid>
                    <Image x:Name="screenShareImage" Stretch="Uniform" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Canvas x:Name="cursorCanvas" Background="Transparent" IsHitTestVisible="False"/>
                    <TextBlock x:Name="txtScreenSharePlaceholder" 
                               Text="Nessuna condivisione attiva" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="16"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Grid>
            </Border>
        </GroupBox>

        <!-- COLONNA DESTRA: Chat e Partecipanti (Colonna 2) -->
        <GroupBox Header="Chat e Partecipanti" Grid.Row="2" Grid.Column="2" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Lista partecipanti -->
                    <RowDefinition Height="*"/>
                    <!-- Chat messages -->
                    <RowDefinition Height="Auto"/>
                    <!-- Input chat -->
                </Grid.RowDefinitions>

                <!-- Chat messages -->
                <ListBox x:Name="lstChat" Grid.Row="1" 
                         Background="#2D2D30" 
                         Foreground="White" 
                         BorderThickness="0" 
                         Margin="0,5,0,5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Sender}" FontWeight="Bold" Foreground="LightBlue"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="5,0,0,5"/>
                                <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="Gray" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Input chat -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBox x:Name="txtChatMessage" Width="180" Margin="0,0,5,0" Height="25"/>
                    <Button x:Name="btnSendChat" Content="Invia" Width="60" Height="25"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
