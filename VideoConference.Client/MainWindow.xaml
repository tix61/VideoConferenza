<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Conference Client" Height="756" Width="1051">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection Panel -->
        <GroupBox Header="Connessione" Grid.Row="0" Margin="10,10,10,10">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtServerUrl" Text="https://192.168.1.56:5001" Width="200" Margin="5"/>
                <TextBox x:Name="txtUserName" Text="Utente1" Width="100" Margin="5"/>
                <TextBox x:Name="txtRoomId" Text="stanza1" Width="100" Margin="5"/>
                <Button x:Name="btnConnect" Content="Connetti" Width="80" Margin="5"/>
                <Button x:Name="btnDisconnect" Content="Disconnetti" Width="80" Margin="5"/>
                <Button x:Name="btnShareScreen" Content="🖥️ Condividi Schermo" Width="130" Margin="5" Height="30" Background="LightBlue" FontWeight="Bold" ToolTip="Condividi lo schermo con gli altri utenti"/>
                <Button x:Name="btnStopShare" Content="⏹️ Ferma Condivisione" Width="130" Margin="5" Height="30" Background="LightPink" FontWeight="Bold" ToolTip="Ferma la condivisione schermo" IsEnabled="False"/>
            </StackPanel>
        </GroupBox>
    
        <!-- Status Panel -->
        <GroupBox Header="Stato" Grid.Row="1" Margin="10,10,10,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtStatus" Text="Non connesso" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="txtVideoStatus" Text="Video: Disattivo" Margin="10" VerticalAlignment="Center" Foreground="Red" FontWeight="Bold"/>
                <TextBlock x:Name="txtAudioStatus" Text="Audio: Disattivo" Margin="10" VerticalAlignment="Center" Foreground="Red" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <!-- Video Panels -->
        <Grid Grid.Row="2" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <!-- Screen Share Preview -->
            <GroupBox Header="Condivisione Schermo" Grid.Column="0" Margin="5">
                <Border BorderBrush="Gray" BorderThickness="1" Background="Black">
                    <Grid>
                        <Image x:Name="screenShareImage" 
                       Stretch="Uniform"/>
                        <TextBlock x:Name="txtScreenSharePlaceholder" 
                           Text="Nessuna condivisione attiva" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="14"/>
                    </Grid>
                </Border>
            </GroupBox>

            <!-- Local Video -->
            <GroupBox Header="Video Locale" Grid.Column="1" Margin="5">
                <Border BorderBrush="Gray" BorderThickness="1" Background="Black">
                    <Grid>
                        <Image x:Name="localVideoImage" 
                               Stretch="Uniform" Width="100" Height="100" VerticalAlignment="Top"/>
                        <TextBlock x:Name="txtLocalVideoPlaceholder" 
                                   Text="Nessun video disponibile" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Grid>
                </Border>
            </GroupBox>

            <!-- Remote Video -->
            <GroupBox Header="Video Remoto" Grid.Column="2" Margin="5">
                <Border BorderBrush="Gray" BorderThickness="1" Background="Black">
                    <Grid>
                        <Image x:Name="remoteVideoImage" 
                               Stretch="Uniform" Width="100" Height="100" VerticalAlignment="Top"/>
                        <TextBlock x:Name="txtRemoteVideoPlaceholder" 
                                   Text="In attesa di connessione remota" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Grid>
                </Border>
            </GroupBox>

        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10" Width="770">
            <Button x:Name="btnStartVideo" Content="Avvia Video" Width="100" Margin="5"/>
            <Button x:Name="btnStopVideo" Content="Ferma Video" Width="100" Margin="5"/>
            <Button x:Name="btnStartAudio" Content="Avvia Audio" Width="100" Margin="5" IsEnabled="False"/>
            <Button x:Name="btnStopAudio" Content="Ferma Audio" Width="100" Margin="5" IsEnabled="False"/>
            <!-- PULSANTE TEST AUDIO -->
            <Button x:Name="btnTestAudio" Content="🔊 Test Audio" Width="100" Margin="5" Height="30" Background="LightGreen" FontWeight="Bold" ToolTip="Testa il funzionamento dell'audio"/>
            <Button x:Name="btnTestAudioSend" Content="📢 Test Invia Audio" Width="120" Margin="5" Height="30" Background="LightYellow" Click="btnTestAudioSend_Click"/>
            <Button x:Name="btnMuteMic" Content="🎤 Mute" Width="80" Margin="5" Height="30" Background="LightGray" Click="btnMuteMic_Click"/>
        </StackPanel>
    </Grid>
</Window>